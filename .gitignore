# Python byte code and cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Streamlit secrets (keep local)
.streamlit/secrets.toml

# Model artifacts MUST be tracked for Streamlit Community Cloud instant startup
!artifacts/
!artifacts/*
